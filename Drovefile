load(".context/eventlog-reactors.star", "eventlog_reactors")

backend("herdr")
herdr.session("drove")

control = workspace("control", panes = [
    herdr.tab("coordinator", split = herdr.DOWN, ratios = [0.5], panes = [
        caller_pane("controller"),
        pane("eventlog", serve = ["eventlog", "view", "--follow"]),
    ]),
    herdr.tab("monitor: system + agents", panes = [
        pane("agentmon", serve = any_of(["agentmon", "--since", "launch"], ["htop"])),
    ]),
])

maintenance = workspace("maintenance", panes = [
    herdr.tab("lazygit", panes = [pane("gitlog", serve = any_of(["lazygit"], ["bash"]))]),
] + eventlog_reactors())

files = workspace("files", panes = [
    herdr.tab("files", panes = [pane("spiceedit", serve = any_of(["spiceedit"], ["bash"]))]),
])

default = profile("default", workspaces = [control, maintenance, files])

monitoring_ws = workspace("monitoring", panes = [
    herdr.tab("log + history", split = herdr.DOWN, ratios = [0.7], panes = [
        pane("eventlog", serve = ["eventlog", "view", "--follow"]),
        pane("gitlog", serve = ["git", "log", "--oneline", "-20"]),
    ]),
])

profile("monitoring", session = "drove-mon", workspaces = [monitoring_ws])
